{
  "name": "oxlint-plugin-better-antislop",
  "version": "0.1.0",
  "description": "Oxlint rules that reject low-evidence TypeScript patterns and gate function-level complexity metrics.",
  "keywords": [
    "complexity",
    "eslint-plugin",
    "oxlint",
    "oxlint-plugin",
    "static-analysis"
  ],
  "license": "MIT",
  "files": [
    "src",
    "vendor"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "bun test ./test/",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run test && bun run conformance && bun run vendor:test && bun run format:check",
    "conformance": "bun tools/conformance/index.ts",
    "vendor:sync": "bun scripts/vendor-sync.ts",
    "vendor:test": "node --test vendor/anti-slop/src/rules/*.test.ts vendor/anti-slop/src/effect/rules/*.test.ts"
  },
  "dependencies": {
    "@oxlint/plugins": "1.87.0",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  }
}
